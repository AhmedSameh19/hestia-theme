{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }}</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="bg-warm-brown text-primary-fixed font-body-md">
  <div class="min-h-screen flex flex-col items-center justify-center px-margin-mobile text-center gap-10">
    <img width="9000" height="4500" src="{{ 'logo-wordmark-cream.png' | asset_url }}" alt="{{ shop.name }}" class="h-20 w-auto object-contain">
    <p class="font-body-lg text-body-lg max-w-md opacity-80">{{ shop.password_message | default: 'Opening soon.' }}</p>
    {% form 'storefront_password' %}
      <div class="flex gap-4 border-b border-primary-fixed/30 pb-2">
        <input type="password" name="password" placeholder="{{ 'general.password' | t }}"
               class="bg-transparent border-none focus:outline-none focus:ring-0 text-primary-fixed placeholder:text-primary-fixed/40">
        <button type="submit" class="font-label-caps text-label-caps uppercase tracking-widest">{{ 'general.enter' | t }}</button>
      </div>
    {% endform %}
  </div>
</body>
</html>
