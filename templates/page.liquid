<div class="pt-24 pb-section-padding px-margin-mobile max-w-3xl mx-auto">
  <h1 class="font-display-lg text-display-lg-mobile md:text-headline-md mb-12">{{ page.title }}</h1>
  <div class="font-body-lg text-body-lg text-on-surface-variant space-y-6 prose">{{ page.content }}</div>

  {%- comment -%} ponytail: handle-gated contact form — no template assignment needed in admin {%- endcomment -%}
  {%- if page.handle == 'contact' -%}
    {%- form 'contact', class: 'mt-12 flex flex-col gap-8' -%}
      {%- if form.posted_successfully? -%}
        <p class="font-body-md text-body-md text-on-tertiary-container bg-tertiary-container rounded-lg px-6 py-4">{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="font-body-md text-body-md text-on-error-container bg-error-container rounded-lg px-6 py-4">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      {%- endif -%}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <input type="text" name="contact[name]" autocomplete="name" placeholder="{{ 'contact.name' | t }}"
               class="bg-transparent border-b border-outline-variant py-3 font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant/60 focus:outline-none focus:border-primary transition-colors">
        <input type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'general.email_placeholder' | t }}"
               class="bg-transparent border-b border-outline-variant py-3 font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant/60 focus:outline-none focus:border-primary transition-colors">
      </div>
      <input type="tel" name="contact[phone]" autocomplete="tel" placeholder="{{ 'contact.phone' | t }}"
             class="bg-transparent border-b border-outline-variant py-3 font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant/60 focus:outline-none focus:border-primary transition-colors">
      <textarea name="contact[body]" rows="6" required placeholder="{{ 'contact.message' | t }}"
                class="bg-transparent border-b border-outline-variant py-3 font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant/60 focus:outline-none focus:border-primary transition-colors resize-y"></textarea>
      <button type="submit" class="self-start font-label-caps text-label-caps uppercase tracking-widest bg-primary text-on-primary rounded-full px-10 py-4 hover:opacity-90 transition-opacity">
        {{ 'contact.send' | t }}
      </button>
    {%- endform -%}
  {%- endif -%}
</div>
