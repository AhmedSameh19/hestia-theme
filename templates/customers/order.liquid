<div class="pt-24 pb-section-padding px-margin-mobile md:px-margin-desktop max-w-3xl mx-auto">
  <h1 class="font-display-lg text-headline-md mb-4">{{ order.name }}</h1>
  <p class="font-body-md text-on-surface-variant mb-12">{{ order.created_at | date: '%B %d, %Y' }} &middot; {{ order.financial_status_label }}</p>
  <div class="space-y-6 mb-12">
    {% for line_item in order.line_items %}
      <div class="flex justify-between items-center pb-6 border-b border-outline-variant/30">
        <div>
          <p class="font-headline-sm text-[18px]">{{ line_item.title }}</p>
          <p class="font-body-md text-on-surface-variant">x{{ line_item.quantity }}</p>
        </div>
        <span class="font-body-md">{{ line_item.final_line_price | money }}</span>
      </div>
    {% endfor %}
  </div>
  <div class="space-y-3 max-w-xs ml-auto">
    <div class="flex justify-between font-body-md"><span class="text-on-surface-variant">{{ 'cart.subtotal' | t }}</span><span>{{ order.line_items_subtotal_price | money }}</span></div>
    {% for shipping_method in order.shipping_methods %}
      <div class="flex justify-between font-body-md"><span class="text-on-surface-variant">{{ shipping_method.title }}</span><span>{{ shipping_method.price | money }}</span></div>
    {% endfor %}
    <div class="flex justify-between font-body-md font-bold pt-3 border-t border-outline-variant/30"><span>{{ 'cart.total' | t }}</span><span>{{ order.total_price | money }}</span></div>
  </div>
</div>
