<div class="pt-24 pb-section-padding px-margin-mobile max-w-md mx-auto">
  <h1 class="font-display-lg text-headline-md mb-12">{{ 'customers.create_account' | t }}</h1>
  {% form 'create_customer', class: 'space-y-6' %}
    {{ form.errors | default_errors }}
    <input type="text" name="customer[first_name]" placeholder="{{ 'customers.first_name' | t }}" autocomplete="given-name"
           class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-3 focus:ring-1 focus:ring-terracotta outline-none">
    <input type="text" name="customer[last_name]" placeholder="{{ 'customers.last_name' | t }}" autocomplete="family-name"
           class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-3 focus:ring-1 focus:ring-terracotta outline-none">
    <input type="email" name="customer[email]" placeholder="{{ 'general.email_placeholder' | t }}" autocomplete="email" required
           class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-3 focus:ring-1 focus:ring-terracotta outline-none">
    <input type="password" name="customer[password]" placeholder="{{ 'general.password' | t }}" autocomplete="new-password" required
           class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-3 focus:ring-1 focus:ring-terracotta outline-none">
    <button type="submit" class="w-full bg-terracotta text-white py-4 rounded-xl font-label-caps text-label-caps uppercase tracking-widest hover:brightness-110 transition-all">{{ 'customers.create_account' | t }}</button>
  {% endform %}
</div>
