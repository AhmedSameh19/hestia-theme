<div class="pt-24 pb-section-padding px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
  <div class="flex justify-between items-baseline mb-16">
    <h1 class="font-display-lg text-headline-md">{{ 'customers.account' | t }}</h1>
    <a href="{{ routes.account_logout_url }}" class="font-label-caps text-label-caps uppercase text-on-surface-variant hover:text-primary">{{ 'customers.logout' | t }}</a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
    <div class="md:col-span-8">
      <h2 class="font-headline-sm text-headline-sm mb-8">{{ 'customers.order_history' | t }}</h2>
      {% paginate customer.orders by 10 %}
        {% if customer.orders.size == 0 %}
          <p class="font-body-md text-on-surface-variant">{{ 'customers.no_orders' | t }}</p>
        {% else %}
          <div class="space-y-4">
            {% for order in customer.orders %}
              <a href="{{ order.customer_url }}" class="flex justify-between items-center p-6 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors">
                <span class="font-label-caps text-label-caps uppercase">{{ order.name }}</span>
                <span class="font-body-md text-on-surface-variant">{{ order.created_at | date: '%b %d, %Y' }}</span>
                <span class="font-body-md">{{ order.total_price | money }}</span>
                <span class="font-label-caps text-[10px] uppercase text-sage">{{ order.financial_status_label }}</span>
              </a>
            {% endfor %}
          </div>
        {% endif %}
        {% if paginate.pages > 1 %}<div class="mt-12 font-label-caps">{{ paginate | default_pagination }}</div>{% endif %}
      {% endpaginate %}
    </div>
    <div class="md:col-span-4">
      <h2 class="font-headline-sm text-headline-sm mb-8">{{ 'customers.details' | t }}</h2>
      <p class="font-body-md mb-2">{{ customer.name }}</p>
      <p class="font-body-md text-on-surface-variant mb-6">{{ customer.email }}</p>
      {% if customer.default_address %}<div class="font-body-md text-on-surface-variant">{{ customer.default_address | format_address }}</div>{% endif %}
      <a href="{{ routes.account_addresses_url }}" class="inline-block mt-6 font-label-caps text-label-caps uppercase underline underline-offset-4 hover:text-primary">{{ 'customers.manage_addresses' | t }}</a>
    </div>
  </div>
</div>
