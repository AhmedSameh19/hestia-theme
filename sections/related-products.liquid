<section class="pb-section-padding max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop fade-in-section">
  <div class="flex justify-between items-end mb-12">
    <div>
      <h2 class="font-headline-md text-headline-md mb-2">{{ section.settings.heading }}</h2>
      <p class="font-label-caps text-label-caps text-on-surface-variant uppercase">{{ section.settings.subheading }}</p>
    </div>
  </div>
  {%- comment -%} ponytail: recommendations is only populated via the Section Rendering API;
      static render falls back to the product's first collection, then the auto "all" collection {%- endcomment -%}
  {%- assign recs = recommendations.products -%}
  {%- if recs == blank -%}{%- assign recs = product.collections.first.products -%}{%- endif -%}
  {%- if recs == blank -%}{%- assign recs = collections['all'].products -%}{%- endif -%}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
    {%- assign shown = 0 -%}
    {%- for rec in recs -%}
      {%- if rec.id == product.id or shown >= 3 -%}{%- continue -%}{%- endif -%}
      {% render 'product-card', product: rec, show_quick_add: true %}
      {%- assign shown = shown | plus: 1 -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Complete your domestic sanctuary" }
  ]
}
{% endschema %}
