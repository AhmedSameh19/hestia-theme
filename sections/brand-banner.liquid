<section class="bg-sage text-white py-24 relative overflow-hidden fade-in-section">
  <div class="absolute right-[-10%] top-1/2 -translate-y-1/2 opacity-10 w-[500px] h-[500px]">
    <img width="752" height="1000" src="{{ 'logo-monogram.png' | asset_url }}" alt="" class="w-full h-full object-contain invert" loading="lazy">
  </div>
  <div class="max-w-4xl mx-auto px-margin-mobile text-center relative z-10">
    <div class="mb-8 flex justify-center">
      <img width="752" height="1000" src="{{ 'logo-monogram.png' | asset_url }}" alt="" class="w-12 h-12 object-contain invert opacity-60" loading="lazy">
    </div>
    <h2 class="font-display-lg text-display-lg-mobile md:text-headline-md mb-8 italic">{{ section.settings.heading }}</h2>
    <p class="font-body-lg text-lg leading-relaxed opacity-90 max-w-2xl mx-auto">{{ section.settings.text }}</p>
    {%- if section.settings.link_label != blank -%}
      <div class="mt-12">
        <a class="font-label-caps text-label-caps uppercase border-b-2 border-white pb-2 hover:opacity-75 transition-opacity tracking-widest" href="{{ section.settings.link }}">
          {{ section.settings.link_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted for the Art of Slow Living" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "HESTIA is a domestic sanctuary brand. We believe the home is a sacred space, and what you wear should reflect the tranquility you seek within your four walls. Every piece is designed to be lived in, washed, and cherished for years to come." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read our story" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Brand banner" }]
}
{% endschema %}
