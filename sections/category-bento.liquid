<section class="py-section-padding px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto fade-in-section">
  <div class="flex flex-col md:flex-row justify-between items-baseline mb-16 gap-4">
    <h2 class="font-headline-md text-headline-md">{{ section.settings.heading }}</h2>
    <a class="font-label-caps text-label-caps uppercase text-on-surface-variant border-b border-outline-variant hover:border-primary transition-colors pb-1"
       href="{{ routes.collections_url }}">{{ section.settings.link_label }}</a>
  </div>

  {%- assign cards = section.blocks -%}
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter h-auto md:h-[600px]">
    {%- for block in cards limit: 2 -%}
      <a href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}"
         class="{% if forloop.first %}md:col-span-4{% else %}md:col-span-8{% endif %} group relative overflow-hidden rounded-3xl bento-card-zoom cursor-pointer bg-secondary-container min-h-[300px]"
         {{ block.shopify_attributes }}>
        {%- assign img = block.settings.image | default: block.settings.collection.featured_image -%}
        {%- if img -%}
          <img width="{{ img.width }}" height="{{ img.height }}" src="{{ img | image_url: width: 1200 }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="w-full h-full object-cover">
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
        {%- endif -%}
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
        <div class="absolute bottom-8 left-8">
          <span class="font-label-caps text-label-caps text-white mb-2 block tracking-widest">{{ forloop.index | prepend: '0' }}</span>
          <h3 class="font-headline-sm text-headline-sm text-white">{{ block.settings.title | default: block.settings.collection.title }}</h3>
        </div>
      </a>
    {%- endfor -%}
  </div>

  {%- if cards.size > 2 -%}
    {%- assign block = cards[2] -%}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter mt-gutter">
      <a href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}"
         class="md:col-span-12 group relative overflow-hidden rounded-3xl h-64 bento-card-zoom cursor-pointer bg-tertiary-container block"
         {{ block.shopify_attributes }}>
        {%- assign img = block.settings.image | default: block.settings.collection.featured_image -%}
        {%- if img -%}
          <img width="{{ img.width }}" height="{{ img.height }}" src="{{ img | image_url: width: 2400 }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="w-full h-full object-cover">
        {%- else -%}
          {{ 'collection-2' | placeholder_svg_tag: 'w-full h-full object-cover' }}
        {%- endif -%}
        <div class="absolute inset-0 bg-black/10"></div>
        <div class="absolute inset-0 flex flex-col justify-center items-center text-center">
          <h3 class="font-headline-md text-headline-md text-white mb-2">{{ block.settings.title | default: block.settings.collection.title }}</h3>
          <p class="font-label-caps text-label-caps text-white tracking-[0.2em] uppercase">{{ block.settings.subtitle }}</p>
        </div>
      </a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Category bento",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Curated Comfort" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all categories" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the collection image" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "subtitle", "label": "Subtitle (wide card only)", "default": "Explore textures" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category bento",
      "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }]
    }
  ]
}
{% endschema %}
