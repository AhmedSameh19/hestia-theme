<section id="featured-products" class="py-20 px-6 lg:px-10 transition-colors duration-300 bg-white dark:bg-[#141414]">
  <div class="max-w-7xl mx-auto">
    {%- comment -%} Section Header {%- endcomment -%}
    <div class="text-center mb-12">
      <p class="text-[9px] tracking-[0.42em] uppercase mb-3 font-medium" style="color: #A87052;" data-i18n="curatedForYou">
        Curated for You
      </p>
      <h2 class="font-light mb-8 font-display text-[clamp(36px,5vw,52px)] text-[#2D2E2D] dark:text-[#F8F6F1] transition-colors" data-i18n="featuredPieces">
        Featured Pieces
      </h2>

      {%- comment -%} Filter Tabs {%- endcomment -%}
      <div class="inline-flex border" style="border-color: #BCBCBC;">
        {%- assign tabs = "All,Women,Men,Together" | split: "," -%}
        {%- for tab in tabs -%}
          <button type="button" data-product-tab="{{ tab }}"
                  class="product-tab-btn text-[9px] tracking-[0.22em] uppercase px-6 py-2.5 transition-all duration-200 font-medium {% if forloop.first %}active-tab text-white{% else %}text-[#494D57] dark:text-[#9A9690] hover:text-[#2D2E2D]{% endif %}"
                  style="{% if forloop.first %}background: #A87052;{% else %}background: transparent;{% endif %}">
            <span data-i18n="tab_{{ tab | downcase }}">{{ tab }}</span>
          </button>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%}
      Real products, not a static mockup. Pulls from the collection picked in the
      section settings (defaults to "All products") so this always reflects the
      live catalog, real prices, real sizes and a working add-to-cart.
    {%- endcomment -%}
    {%- assign featured_collection = section.settings.collection | default: collections.all -%}
    <div data-featured-grid class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar md:grid md:grid-cols-3 gap-5 lg:gap-8 pb-4 -mx-6 px-6 md:mx-0 md:px-0">
      {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
        <div class="product-card-item w-[72vw] sm:w-[48vw] md:w-auto shrink-0 snap-start {% unless forloop.index0 < 6 %}hidden{% endunless %}">
          {% render 'product-card', product: product %}
        </div>
      {%- else -%}
        <p class="col-span-full text-center font-body-md text-[#494D57] dark:text-[#9A9690]">{{ 'collections.empty' | t }}</p>
      {%- endfor -%}
    </div>

    {%- comment -%} Bottom Buttons: Load More & View All Products {%- endcomment -%}
    <div class="text-center mt-14 flex flex-col sm:flex-row items-center justify-center gap-4">
      <button type="button" data-load-more
              class="inline-flex items-center gap-3 text-[10px] tracking-[0.22em] uppercase px-10 py-4 border transition-colors hover:text-white font-medium border-[#494D57] text-[#494D57] hover:bg-[#494D57] dark:border-[#9A9690] dark:text-[#9A9690] dark:hover:bg-[#494D57]">
        <span data-i18n="loadMore">Load More</span>
      </button>
      <a href="{{ routes.all_products_collection_url }}"
         class="inline-flex items-center gap-3 text-[10px] tracking-[0.22em] uppercase px-10 py-4 border transition-colors hover:text-white font-medium border-[#494D57] text-[#494D57] hover:bg-[#494D57] dark:border-[#9A9690] dark:text-[#9A9690] dark:hover:bg-[#494D57]">
        <span data-i18n="viewAllProducts">View All Products</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured pieces",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to All products if none is chosen" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 6, "max": 24, "step": 3, "default": 12 }
  ],
  "presets": [{ "name": "Featured pieces" }]
}
{% endschema %}
