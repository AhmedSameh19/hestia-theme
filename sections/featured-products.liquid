          <button type="button" data-ask-question="Champagne Dreams" class="text-[8px] tracking-[0.2em] uppercase hover:opacity-60 transition-opacity border-b pb-px text-[#494D57]/40 border-[#494D57]/40 dark:text-white/40">Ask a question</button>
