<section class="py-section-padding bg-surface-container-low overflow-hidden fade-in-section">
  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto mb-16">
    <div class="text-center mb-8">
      {%- if section.settings.eyebrow != blank -%}
        <span class="font-label-caps text-label-caps uppercase text-on-secondary-container mb-4 block">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="font-headline-md text-headline-md">{{ section.settings.heading }}</h2>
    </div>
    <div data-product-filters class="flex justify-center gap-2">
      <button type="button" data-filter="all" class="font-label-caps text-label-caps uppercase px-5 py-2 border border-outline-variant data-[active=true]:bg-terracotta data-[active=true]:text-white data-[active=true]:border-terracotta" data-active="true">{{ 'general.all' | t }}</button>
      <button type="button" data-filter="women" class="font-label-caps text-label-caps uppercase px-5 py-2 border border-outline-variant data-[active=true]:bg-terracotta data-[active=true]:text-white data-[active=true]:border-terracotta hover:border-primary" data-active="false">{{ 'general.women' | t }}</button>
      <button type="button" data-filter="men" class="font-label-caps text-label-caps uppercase px-5 py-2 border border-outline-variant data-[active=true]:bg-terracotta data-[active=true]:text-white data-[active=true]:border-terracotta hover:border-primary" data-active="false">{{ 'general.men' | t }}</button>
      <button type="button" data-filter="together" class="font-label-caps text-label-caps uppercase px-5 py-2 border border-outline-variant data-[active=true]:bg-terracotta data-[active=true]:text-white data-[active=true]:border-terracotta hover:border-primary" data-active="false">{{ 'general.together' | t }}</button>
    </div>
    <div class="hidden md:flex justify-end gap-4 mt-4">
      <button type="button" data-carousel-prev class="w-12 h-12 rounded-full border border-outline-variant flex items-center justify-center hover:bg-surface transition-colors" aria-label="{{ 'general.previous' | t }}">
        <span class="material-symbols-outlined">chevron_left</span>
      </button>
      <button type="button" data-carousel-next class="w-12 h-12 rounded-full border border-outline-variant flex items-center justify-center hover:bg-surface transition-colors" aria-label="{{ 'general.next' | t }}">
        <span class="material-symbols-outlined">chevron_right</span>
      </button>
    </div>
  </div>

  <div data-carousel class="flex gap-gutter px-margin-mobile md:px-margin-desktop scroll-pl-margin-mobile md:scroll-pl-margin-desktop max-w-container-max mx-auto overflow-x-auto pb-10 no-scrollbar snap-x">
    {%- assign products = section.settings.collection.products -%}
    {%- comment -%} ponytail: falls back to the auto "all" collection until the merchant creates the configured one. `== blank` matches both nil and empty {%- endcomment -%}
    {%- if products == blank -%}{%- assign products = collections['all'].products -%}{%- endif -%}
    {%- if products.size > 0 -%}
      {%- for product in products limit: section.settings.limit -%}
        <div class="min-w-[280px] md:min-w-[360px] snap-start"
             data-product-type="{% if product.tags contains 'women' %}women{% elsif product.tags contains 'men' %}men{% elsif product.tags contains 'together' %}together{% else %}all{% endif %}">
          {% render 'product-card', product: product, show_quick_add: true %}
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="min-w-[280px] md:min-w-[360px] snap-start group" data-product-type="all">
          <div class="aspect-[3/4] rounded-2xl overflow-hidden mb-6 product-shadow bg-surface-container-lowest">
            {{ 'product-' | append: i | placeholder_svg_tag: 'w-full h-full object-cover' }}
          </div>
          <h4 class="font-headline-sm text-[20px] mb-1">{{ 'products.placeholder_title' | t }}</h4>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated for you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Pieces" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
