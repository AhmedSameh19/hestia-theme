{%- comment -%}
  The real cart drawer — server-rendered from the live Shopify cart. Always present
  in the DOM (hidden by default) so theme.js can open/close it via [data-close-drawer]
  the same way as every other drawer, and re-fetch this whole section via
  fetch(routes.root_url + '?section_id=cart-drawer') after every cart mutation to get
  fresh, real markup back (Shopify's Section Rendering API).
{%- endcomment -%}
<div id="modal-cart-drawer" hidden class="fixed inset-0 z-[100] transition-opacity duration-300" style="display: none;">
  <div class="modal-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm" data-close-drawer="cart"></div>
  <aside class="modal-panel absolute right-0 top-0 h-full w-full max-w-md bg-white dark:bg-[#1C1C1C] text-[#2D2E2D] dark:text-[#F0EDE8] shadow-2xl flex flex-col transition-transform duration-300 transform translate-x-0">
    <div class="flex items-center justify-between px-6 py-5 border-b border-black/10 dark:border-white/10 shrink-0">
      <h2 class="font-display text-xl font-light tracking-wide">{{ 'cart.title' | t }} ({{ cart.item_count }})</h2>
      <button type="button" data-close-drawer="cart" class="p-1.5 hover:opacity-60 transition-opacity" aria-label="{{ 'general.close' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    {%- assign threshold = section.settings.free_shipping_threshold | times: 100 -%}
    {%- if threshold > 0 -%}
      <div class="px-6 py-3 bg-[#F8F6F1] dark:bg-[#242424] border-b border-black/5 dark:border-white/5 shrink-0">
        {%- assign remaining = threshold | minus: cart.total_price -%}
        <p class="text-[10px] tracking-[0.15em] uppercase mb-1.5 text-[#494D57] dark:text-[#9A9690]">
          {%- if remaining > 0 -%}
            {{ 'cart.until_free_shipping' | t: amount: remaining | money }}
          {%- else -%}
            {{ 'cart.free_shipping_unlocked' | t }}
          {%- endif -%}
        </p>
        <div class="w-full h-1 bg-black/10 dark:bg-white/10 overflow-hidden">
          {%- assign pct = cart.total_price | times: 100 | divided_by: threshold | at_most: 100 -%}
          <div class="h-full bg-[#A87052] transition-all duration-500" style="width: {{ pct }}%;"></div>
        </div>
      </div>
    {%- endif -%}

    {%- if cart.item_count == 0 -%}
      <div class="flex-1 flex flex-col items-center justify-center gap-6 px-6 text-center">
        <p class="font-display text-lg font-light">{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" data-close-drawer="cart"
           class="inline-block px-8 py-3 text-[10px] tracking-[0.2em] uppercase font-medium bg-[#A87052] text-white hover:opacity-85 transition-opacity">
          {{ 'cart.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      <div class="flex-1 overflow-y-auto px-6 divide-y divide-black/5 dark:divide-white/5">
        {%- for item in cart.items -%}
          <div class="flex gap-4 py-6">
            <a href="{{ item.url }}" class="w-20 h-24 overflow-hidden shrink-0 bg-[#E5D7CD]">
              {%- if item.image -%}
                <img width="{{ item.image.width }}" height="{{ item.image.height }}" src="{{ item.image | image_url: width: 160 }}" alt="{{ item.image.alt | escape }}" loading="lazy" class="w-full h-full object-cover">
              {%- endif -%}
            </a>
            <div class="flex flex-col justify-between flex-1 min-w-0 gap-3">
              <div class="flex justify-between items-start gap-3">
                <div class="min-w-0">
                  <h3 class="font-display text-sm font-light truncate"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="text-[#494D57] dark:text-[#9A9690] text-[11px] mt-0.5">{{ item.variant.title }}</p>
                  {%- endunless -%}
                </div>
                <span class="text-xs font-medium shrink-0">{{ item.final_line_price | money }}</span>
              </div>
              <div class="flex justify-between items-center">
                <div class="flex items-center border border-black/15 dark:border-white/15 px-2 py-1 gap-3">
                  <button type="button" data-drawer-qty="{{ forloop.index }}" data-delta="-1" class="text-xs px-1 hover:text-[#A87052] transition-colors" aria-label="{{ 'general.decrease' | t }}">&minus;</button>
                  <span class="text-xs font-medium min-w-[16px] text-center">{{ item.quantity }}</span>
                  <button type="button" data-drawer-qty="{{ forloop.index }}" data-delta="1" class="text-xs px-1 hover:text-[#A87052] transition-colors" aria-label="{{ 'general.increase' | t }}">&plus;</button>
                </div>
                <button type="button" data-drawer-remove="{{ forloop.index }}"
                        class="text-[10px] tracking-[0.15em] uppercase text-[#494D57] dark:text-[#9A9690] underline underline-offset-4 hover:text-[#A87052] transition-colors">
                  {{ 'cart.remove' | t }}
                </button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="p-6 border-t border-black/10 dark:border-white/10 shrink-0 space-y-4 bg-white dark:bg-[#1C1C1C]">
        <div class="flex justify-between text-sm font-medium">
          <span class="text-[#494D57] dark:text-[#9A9690]">{{ 'cart.subtotal' | t }}</span>
          <span class="font-display text-lg font-light">{{ cart.items_subtotal_price | money }}</span>
        </div>
        <p class="text-[11px] text-[#494D57]/70 dark:text-[#9A9690]/70">{{ 'cart.taxes_note' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout"
                  class="w-full bg-[#A87052] text-white py-4 text-[10px] tracking-[0.22em] uppercase font-medium hover:opacity-85 transition-opacity shadow-lg shadow-[#A87052]/20">
            {{ 'cart.checkout' | t }}
          </button>
        </form>
        <a href="{{ routes.cart_url }}" class="block text-center text-[10px] tracking-[0.18em] uppercase text-[#494D57] dark:text-[#9A9690] hover:text-[#A87052] transition-colors">
          {{ 'cart.view_cart' | t }}
        </a>
      </div>
    {%- endif -%}
  </aside>
</div>

{% schema %}
{
  "name": "Cart drawer (API)",
  "settings": [
    { "type": "number", "id": "free_shipping_threshold", "label": "Free shipping threshold", "info": "In store currency units. 0 hides the progress bar.", "default": 2500 }
  ]
}
{% endschema %}
