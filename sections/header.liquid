{%- if section.settings.announcement != blank -%}
  <div class="bg-sage text-charcoal text-center py-2 px-margin-mobile font-label-caps text-[11px] uppercase tracking-widest">
    {{ section.settings.announcement }}
  </div>
{%- endif -%}
<header class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-md shadow-sm">
  <nav class="flex justify-between items-center px-margin-mobile md:px-margin-desktop py-4 max-w-container-max mx-auto h-20">
    <div class="flex-1 flex justify-start items-center gap-4">
      <button data-menu-open class="md:hidden material-symbols-outlined text-on-surface-variant" aria-label="{{ 'general.menu' | t }}">menu</button>
      <a class="block h-8 opacity-90 transition-opacity hover:opacity-100" href="{{ routes.root_url }}">
        {%- if section.settings.logo -%}
          <img width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" src="{{ section.settings.logo | image_url: height: 64 }}" alt="{{ shop.name }}" class="h-full w-auto object-contain">
        {%- else -%}
          {%- comment -%} Cream wordmark: invert to charcoal on the light header, keep cream on dark {%- endcomment -%}
          <img width="826" height="248" src="{{ 'logo-wordmark-cream.png' | asset_url }}" alt="{{ shop.name }}" class="h-full w-auto object-contain invert dark:invert-0">
        {%- endif -%}
      </a>
    </div>

    <div class="hidden md:flex flex-1 justify-center items-center gap-10">
      {%- for link in section.settings.menu.links -%}
        <a class="font-label-caps text-label-caps uppercase relative transition-colors
                  {% if link.current %}text-primary border-b border-primary pb-1 font-bold{% else %}text-on-surface-variant nav-link-hover hover:text-primary{% endif %}"
           href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>

    <div class="flex-1 flex justify-end items-center gap-6">
      <button data-theme-toggle class="material-symbols-outlined text-on-surface-variant hover:text-primary transition-colors" aria-label="{{ 'general.toggle_theme' | t }}">
        <span class="dark:hidden">dark_mode</span><span class="hidden dark:inline">light_mode</span>
      </button>
      <a href="{{ routes.search_url }}" class="material-symbols-outlined text-on-surface-variant hover:text-primary transition-colors" aria-label="{{ 'general.search' | t }}">search</a>
      <div class="relative hidden md:block">
        <button data-account-open class="material-symbols-outlined text-on-surface-variant hover:text-primary transition-colors" aria-label="{{ 'general.account' | t }}" aria-expanded="false">person</button>

        {%- comment -%} Account dropdown — keeps sign-in / account access in-context instead of a full-page nav {%- endcomment -%}
        <div data-account hidden class="absolute right-0 top-full mt-3 w-72 bg-surface border border-outline-variant/30 rounded-xl shadow-lg p-6 z-50">
          {%- if customer -%}
            <p class="font-body-md mb-1">{{ 'customers.account' | t }}</p>
            <p class="font-body-md text-on-surface-variant mb-6 truncate">{{ customer.email }}</p>
            <div class="flex flex-col gap-4 font-label-caps text-label-caps uppercase">
              <a href="{{ routes.account_url }}" class="text-on-surface-variant hover:text-primary">{{ 'customers.order_history' | t }}</a>
              <a href="{{ routes.account_addresses_url }}" class="text-on-surface-variant hover:text-primary">{{ 'customers.manage_addresses' | t }}</a>
              <a href="{{ routes.account_logout_url }}" class="text-on-surface-variant hover:text-primary pt-4 border-t border-outline-variant/30">{{ 'customers.logout' | t }}</a>
            </div>
          {%- else -%}
            <h2 class="font-headline-sm text-headline-sm mb-6">{{ 'customers.login' | t }}</h2>
            {% form 'customer_login', class: 'space-y-4' %}
              {{ form.errors | default_errors }}
              <input type="email" name="customer[email]" placeholder="{{ 'general.email_placeholder' | t }}" autocomplete="email" required
                     class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-3 focus:ring-1 focus:ring-terracotta outline-none">
              <input type="password" name="customer[password]" placeholder="{{ 'general.password' | t }}" autocomplete="current-password" required
                     class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-3 focus:ring-1 focus:ring-terracotta outline-none">
              <button type="submit" class="w-full bg-terracotta text-white py-3 rounded-xl font-label-caps text-label-caps uppercase tracking-widest hover:brightness-110 transition-all">{{ 'customers.login' | t }}</button>
            {% endform %}
            <div class="flex justify-between mt-4 font-label-caps text-label-caps uppercase text-on-surface-variant">
              <a href="{{ routes.account_login_url }}#recover" class="hover:text-primary">{{ 'customers.forgot_password' | t }}</a>
              <a href="{{ routes.account_register_url }}" class="hover:text-primary">{{ 'customers.create_account' | t }}</a>
            </div>
          {%- endif -%}
        </div>
      </div>
      <a href="{{ routes.cart_url }}" class="relative material-symbols-outlined text-on-surface-variant hover:text-primary transition-colors" aria-label="{{ 'general.cart' | t }}">
        shopping_bag
        <span data-cart-count
              class="absolute -top-1 -right-1 bg-terracotta text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center font-bold {% if cart.item_count == 0 %}hidden{% endif %}">{{ cart.item_count }}</span>
      </a>
    </div>
  </nav>

  {%- comment -%} Mobile menu drawer {%- endcomment -%}
  <div data-menu hidden class="md:hidden bg-surface border-t border-outline-variant/30 px-margin-mobile py-8">
    <div class="flex flex-col gap-6">
      {%- for link in section.settings.menu.links -%}
        <a class="font-label-caps text-label-caps uppercase {% if link.current %}text-primary font-bold{% else %}text-on-surface-variant{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      <a class="font-label-caps text-label-caps uppercase text-on-surface-variant" href="{{ routes.account_url }}">{{ 'general.account' | t }}</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Defaults to the HESTIA Xi monogram" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "announcement", "label": "Announcement bar text", "default": "Free delivery across Egypt on orders over LE 2,500 — dummy copy" }
  ]
}
{% endschema %}
