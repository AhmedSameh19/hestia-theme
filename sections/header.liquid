{%- comment -%} Transparent-at-top (white text over the slider) only makes sense on the home page; everywhere else the header starts in its solid "scrolled" state {%- endcomment -%}
<header data-header {% if request.page_type == 'index' %}data-transparent{% endif %} class="group fixed top-0 w-full z-50 transition-all duration-300 [&.scrolled]:bg-surface/80 [&.scrolled]:backdrop-blur-md [&.scrolled]:shadow-sm {% unless request.page_type == 'index' %}scrolled{% endunless %}">
  {%- if section.settings.announcement != blank -%}
    <div class="bg-sage text-charcoal text-center py-2 px-margin-mobile font-label-caps text-[11px] uppercase tracking-widest">
      {{ section.settings.announcement }}
    </div>
  {%- endif -%}
  <nav class="flex justify-between items-center px-margin-mobile md:px-margin-desktop py-4 max-w-container-max mx-auto h-20">
    <div class="flex items-center gap-0 group-[.scrolled]:gap-6 transition-all duration-300">
      <button data-menu-open class="md:hidden material-symbols-outlined text-cream group-[.scrolled]:text-on-surface-variant transition-colors" aria-label="{{ 'general.menu' | t }}">menu</button>
      {%- comment -%} Logo is collapsed at the top of the page (links sit flush left) and expands + fades in once the header gains its scrolled background {%- endcomment -%}
      <a class="block h-8 max-w-0 group-[.scrolled]:max-w-52 overflow-hidden opacity-0 pointer-events-none group-[.scrolled]:opacity-100 group-[.scrolled]:pointer-events-auto transition-all duration-300" href="{{ routes.root_url }}">
        {%- if section.settings.logo -%}
          <img width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" src="{{ section.settings.logo | image_url: height: 64 }}" alt="{{ shop.name }}" class="h-full w-auto object-contain">
        {%- else -%}
          {%- comment -%} Aurca wordmark — dark:hidden picks the clay mark once scrolled/light, light mode/dark mode both stay legible {%- endcomment -%}
          <img src="{{ 'logo-wordmark-clay.svg' | asset_url }}" alt="{{ shop.name }}" width="322" height="65" class="h-full w-auto object-contain dark:hidden">
          <img src="{{ 'logo-wordmark-cream.svg' | asset_url }}" alt="{{ shop.name }}" width="322" height="65" class="h-full w-auto object-contain hidden dark:block">
        {%- endif -%}
      </a>

      <div class="hidden md:flex items-center gap-10">
        {%- for link in section.settings.menu.links -%}
          <a class="font-label-caps text-label-caps uppercase relative transition-colors
                    {% if link.current %}text-cream border-cream group-[.scrolled]:text-primary group-[.scrolled]:border-primary border-b pb-1 font-bold{% else %}text-cream group-[.scrolled]:text-on-surface-variant group-[.scrolled]:hover:text-primary nav-link-hover{% endif %}"
             href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    </div>

    <div class="flex items-center gap-6">
      <button data-theme-toggle class="material-symbols-outlined text-cream group-[.scrolled]:text-on-surface-variant group-[.scrolled]:hover:text-primary transition-colors" aria-label="{{ 'general.toggle_theme' | t }}">
        <span class="dark:hidden">dark_mode</span><span class="hidden dark:inline">light_mode</span>
      </button>
      <a href="{{ routes.search_url }}" data-search-open class="material-symbols-outlined text-cream group-[.scrolled]:text-on-surface-variant group-[.scrolled]:hover:text-primary transition-colors" aria-label="{{ 'general.search' | t }}">search</a>
      <div class="relative hidden md:block">
        <button data-account-open class="material-symbols-outlined text-cream group-[.scrolled]:text-on-surface-variant group-[.scrolled]:hover:text-primary transition-colors" aria-label="{{ 'general.account' | t }}" aria-expanded="false">person</button>

        {%- comment -%} Account dropdown — keeps sign-in / account access in-context instead of a full-page nav {%- endcomment -%}
        <div data-account hidden class="absolute right-0 top-full mt-3 w-72 bg-surface border border-outline-variant/30 rounded-xl shadow-lg p-6 z-50">
          {%- if customer -%}
            <p class="font-body-md mb-1">{{ 'customers.account' | t }}</p>
            <p class="font-body-md text-on-surface-variant mb-6 truncate">{{ customer.email }}</p>
            <div class="flex flex-col gap-4 font-label-caps text-label-caps uppercase">
              <a href="{{ routes.account_url }}" class="text-on-surface-variant hover:text-primary">{{ 'customers.order_history' | t }}</a>
              <a href="{{ routes.account_addresses_url }}" class="text-on-surface-variant hover:text-primary">{{ 'customers.manage_addresses' | t }}</a>
              <a href="{{ routes.account_logout_url }}" class="text-on-surface-variant hover:text-primary pt-4 border-t border-outline-variant/30">{{ 'customers.logout' | t }}</a>
            </div>
          {%- else -%}
            <h2 class="font-headline-sm text-headline-sm mb-6">{{ 'customers.login' | t }}</h2>
            {% form 'customer_login', class: 'space-y-4' %}
              {{ form.errors | default_errors }}
              <input type="email" name="customer[email]" placeholder="{{ 'general.email_placeholder' | t }}" autocomplete="email" required
                     class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-3 focus:ring-1 focus:ring-terracotta outline-none">
              <input type="password" name="customer[password]" placeholder="{{ 'general.password' | t }}" autocomplete="current-password" required
                     class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-3 focus:ring-1 focus:ring-terracotta outline-none">
              <button type="submit" class="w-full bg-terracotta text-white py-3 rounded-xl font-label-caps text-label-caps uppercase tracking-widest hover:brightness-110 transition-all">{{ 'customers.login' | t }}</button>
            {% endform %}
            <div class="flex justify-between mt-4 font-label-caps text-label-caps uppercase text-on-surface-variant">
              <a href="{{ routes.account_login_url }}#recover" class="hover:text-primary">{{ 'customers.forgot_password' | t }}</a>
              <a href="{{ routes.account_register_url }}" class="hover:text-primary">{{ 'customers.create_account' | t }}</a>
            </div>
          {%- endif -%}
        </div>
      </div>
      <a href="{{ routes.cart_url }}" data-cart-open class="relative material-symbols-outlined text-cream group-[.scrolled]:text-on-surface-variant group-[.scrolled]:hover:text-primary transition-colors" aria-label="{{ 'general.cart' | t }}">
        shopping_bag
        <span data-cart-count
              class="absolute -top-1 -right-1 bg-terracotta text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center font-bold {% if cart.item_count == 0 %}hidden{% endif %}">{{ cart.item_count }}</span>
      </a>
    </div>
  </nav>

  {%- comment -%} Mobile menu drawer {%- endcomment -%}
  <div data-menu hidden class="md:hidden bg-surface border-t border-outline-variant/30 px-margin-mobile py-8">
    <div class="flex flex-col gap-6">
      {%- for link in section.settings.menu.links -%}
        <a class="font-label-caps text-label-caps uppercase {% if link.current %}text-primary font-bold{% else %}text-on-surface-variant{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      <a class="font-label-caps text-label-caps uppercase text-on-surface-variant" href="{{ routes.account_url }}">{{ 'general.account' | t }}</a>
    </div>
  </div>
</header>

{%- comment -%}
  Search popup — opens pre-filled with the newest products, then live-replaces the grid
  from the predictive search API as the user types (theme.js). Enter still submits to the
  full search page. Kept outside <header>: its backdrop-filter would trap this fixed overlay.
{%- endcomment -%}
<div data-search-modal hidden class="fixed inset-0 z-[60]">
  <div class="absolute inset-0 bg-charcoal/50 backdrop-blur-sm"></div>
  <div data-search-panel class="relative bg-surface w-[calc(100%-40px)] max-w-3xl mx-auto mt-[8vh] rounded-2xl shadow-xl p-6 md:p-8 max-h-[80vh] overflow-y-auto">
    <form action="{{ routes.search_url }}" method="get" class="flex items-center gap-4 border-b border-outline-variant/50 pb-4 mb-6">
      <span class="material-symbols-outlined text-on-surface-variant" aria-hidden="true">search</span>
      <input data-search-input type="search" name="q" autocomplete="off"
             placeholder="{{ 'general.search_placeholder' | t }}"
             class="flex-1 bg-transparent outline-none font-body-lg text-body-lg placeholder:text-on-surface-variant/60">
      <button type="button" data-search-close class="material-symbols-outlined text-on-surface-variant hover:text-primary transition-colors" aria-label="{{ 'general.close' | t }}">close</button>
    </form>
    <div data-search-results class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {%- for product in collections.all.products limit: 4 -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} Cart side drawer — same fixed-overlay pattern as the search popup (kept outside <header>) {%- endcomment -%}
<div data-cart-drawer hidden class="fixed inset-0 z-[60]">
  <div class="absolute inset-0 bg-charcoal/50 backdrop-blur-sm"></div>
  <aside data-cart-panel class="absolute right-0 top-0 h-full w-full max-w-md bg-surface shadow-2xl">
    <div data-cart-drawer-content class="flex flex-col h-full">
      {% render 'cart-drawer-content' %}
    </div>
  </aside>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Defaults to the Aurca wordmark" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "announcement", "label": "Announcement bar text" }
  ]
}
{% endschema %}
