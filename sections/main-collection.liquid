<div class="pt-12 pb-section-padding px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
  <nav class="mb-12" aria-label="breadcrumbs">
    <ol class="flex items-center gap-2 text-label-caps font-label-caps text-on-surface-variant uppercase">
      <li><a class="hover:text-primary transition-colors" href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
      <li class="flex items-center gap-2">
        <span class="material-symbols-outlined text-[14px]" aria-hidden="true">chevron_right</span>
        <a class="hover:text-primary transition-colors" href="{{ routes.collections_url }}">{{ 'general.collections' | t }}</a>
      </li>
      <li class="flex items-center gap-2 font-bold text-primary" aria-current="page">
        <span class="material-symbols-outlined text-[14px]" aria-hidden="true">chevron_right</span> {{ collection.title }}
      </li>
    </ol>
  </nav>

  {%- liquid
    # Brand colors for the three lines (men/women/together)
    assign brand_bg = ''
    case collection.handle
      when 'men'
        assign brand_bg = '#2D2E2D'
        assign brand_text = '#FFFFFF'
      when 'women'
        assign brand_bg = '#E5D7CD'
        assign brand_text = '#2D2E2D'
      when 'together'
        assign brand_bg = '#A87052'
        assign brand_text = '#FFFFFF'
    endcase
  -%}
  {%- if brand_bg != '' -%}
    <header class="mb-16 rounded-2xl p-8 md:p-12" style="background-color:{{ brand_bg }};color:{{ brand_text }}">
      <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg mb-6">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="max-w-2xl font-body-lg text-body-lg opacity-80">{{ collection.description }}</div>
      {%- endif -%}
    </header>
  {%- else -%}
    <header class="mb-16">
      <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-primary mb-6">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="max-w-2xl font-body-lg text-body-lg text-on-surface-variant">{{ collection.description }}</div>
      {%- endif -%}
    </header>
  {%- endif -%}

  {%- comment -%}
    Filtering & sorting are entirely client-side (theme.js initProductFilters) —
    every product below renders up front with its tags/price/title as data
    attributes, and checking a filter or changing sort just shows/hides/reorders
    these already-rendered cards. No page reload, no server round trip.
  {%- endcomment -%}
  {%- paginate collection.products by section.settings.per_page -%}
    <div data-collection-filters>
      <div class="flex justify-between items-center mb-6 border-b border-surface-variant pb-6">
        <button type="button" data-filters-toggle
                class="flex items-center gap-3 text-label-caps font-label-caps text-on-surface-variant uppercase hover:text-primary transition-colors md:pointer-events-none">
          <span class="material-symbols-outlined">tune</span>
          <span>{{ 'collections.filters' | t }}</span>
          <span data-filters-badge hidden class="w-2 h-2 rounded-full bg-terracotta md:hidden"></span>
        </button>
        <div class="flex items-center gap-4">
          <label for="SortBy" class="text-label-caps font-label-caps text-on-surface-variant uppercase">{{ 'collections.sort_by' | t }}:</label>
          <select id="SortBy" data-sort
                  class="bg-transparent border-none font-label-caps text-label-caps text-primary focus:ring-0 cursor-pointer">
            <option value="manual">{{ 'collections.sort_featured' | t }}</option>
            <option value="title-ascending">{{ 'collections.sort_title_asc' | t }}</option>
            <option value="title-descending">{{ 'collections.sort_title_desc' | t }}</option>
            <option value="price-ascending">{{ 'collections.sort_price_asc' | t }}</option>
            <option value="price-descending">{{ 'collections.sort_price_desc' | t }}</option>
            <option value="created-descending">{{ 'collections.sort_newest' | t }}</option>
          </select>
        </div>
      </div>

      <div data-active-filters hidden class="flex flex-wrap items-center gap-3 mb-10">
        <span class="text-label-caps font-label-caps text-on-surface-variant uppercase">{{ 'collections.active_filters' | t }}:</span>
        <div data-active-filter-chips class="flex flex-wrap items-center gap-3"></div>
        <button type="button" data-clear-filters class="font-label-caps text-label-caps uppercase text-terracotta underline underline-offset-4 hover:opacity-70 transition-opacity">
          {{ 'collections.clear_all' | t }}
        </button>
      </div>

      <div class="flex flex-col md:flex-row gap-gutter">
        <div data-filters-backdrop hidden class="fixed inset-0 bg-black/50 z-40 md:hidden"></div>
        <aside data-filters
               class="fixed inset-y-0 left-0 z-50 w-[86%] max-w-xs -translate-x-full bg-background overflow-y-auto p-6 transition-transform duration-300 ease-out
                      md:static md:z-auto md:w-64 md:max-w-none md:translate-x-0 md:bg-transparent md:overflow-visible md:p-0 md:space-y-10 shrink-0">
          <div class="flex items-center justify-between mb-8 md:hidden">
            <h2 class="font-headline-sm text-headline-sm text-primary">{{ 'collections.filters' | t }}</h2>
            <button type="button" data-filters-close aria-label="{{ 'collections.close_filters' | t }}" class="p-1 text-on-surface-variant hover:text-primary">
              <span class="material-symbols-outlined">close</span>
            </button>
          </div>
          <div class="space-y-10" data-filter-groups>
            {%- comment -%}
              ponytail: built from each product's REAL variant options (Color,
              Size, Size (Her)/Size (Him), ...) rather than a `group:Value` tag
              convention — the catalog was never actually tagged that way, which
              is why "no filters available" always showed. This needs no tagging
              effort at all and can never drift out of sync with real variants.
              Skipped over the Search & Discovery app's filters for the same
              reason as before: that app's filtering is a page nav per click and
              can't be made instant. theme.js fills in each option's product
              count and does the actual show/hide.
            {%- endcomment -%}
            {%- assign size_order = 'XS,S,M,L,XL,XXL' | split: ',' -%}
            {%- assign option_names = '' -%}
            {%- for product in collection.products -%}
              {%- for option in product.options_with_values -%}
                {%- assign marker = option.name | append: '||' -%}
                {%- unless option.name == 'Title' or option_names contains marker -%}
                  {%- assign option_names = option_names | append: marker -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endfor -%}
            {%- assign option_name_list = option_names | split: '||' -%}
            {%- assign filter_groups_found = false -%}
            {%- for group_name in option_name_list -%}
              {%- assign group_handle = group_name | handle -%}
              {%- assign group_values = '' -%}
              {%- for product in collection.products -%}
                {%- for option in product.options_with_values -%}
                  {%- if option.name == group_name -%}
                    {%- for value in option.values -%}
                      {%- assign value_marker = value | append: '||' -%}
                      {%- unless group_values contains value_marker -%}
                        {%- assign group_values = group_values | append: value_marker -%}
                      {%- endunless -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
              {%- assign group_value_list = group_values | split: '||' -%}
              {%- if group_name contains 'Size' -%}
                {%- comment -%} force garment order instead of whatever order values were first seen in {%- endcomment -%}
                {%- assign ordered_values = '' -%}
                {%- for size in size_order -%}
                  {%- if group_value_list contains size -%}
                    {%- assign ordered_values = ordered_values | append: size | append: '||' -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- for value in group_value_list -%}
                  {%- unless size_order contains value -%}
                    {%- assign ordered_values = ordered_values | append: value | append: '||' -%}
                  {%- endunless -%}
                {%- endfor -%}
                {%- assign group_value_list = ordered_values | split: '||' -%}
              {%- endif -%}
              {%- if group_value_list.size > 0 -%}
                {%- assign filter_groups_found = true -%}
                <section>
                  <h3 class="font-label-caps text-label-caps text-primary mb-4 uppercase">{{ group_name }}</h3>
                  <div class="space-y-3">
                    {%- for value in group_value_list -%}
                      <label class="flex items-center gap-3 cursor-pointer group" data-filter-option>
                        <input type="checkbox" data-filter-checkbox data-filter-tag="{{ group_handle }}:{{ value | handle }}"
                               class="w-4 h-4 rounded-full border-outline text-terracotta focus:ring-terracotta">
                        <span class="font-body-md text-on-surface-variant group-hover:text-primary">{{ value }} <span data-filter-count>(0)</span></span>
                      </label>
                    {%- endfor -%}
                  </div>
                </section>
              {%- endif -%}
            {%- endfor -%}
            {%- unless filter_groups_found -%}
              <p class="font-body-md text-on-surface-variant text-[14px]">{{ 'collections.no_filters' | t }}</p>
            {%- endunless -%}
          </div>
          <div class="md:hidden pt-8 mt-4 border-t border-outline-variant/40">
            <button type="button" data-filters-close
                    class="w-full bg-primary text-on-primary rounded-xl h-12 font-label-caps text-label-caps uppercase tracking-widest">
              {{ 'collections.apply_filters' | t }}
            </button>
          </div>
        </aside>

        <div data-product-grid class="flex-1 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-gutter gap-y-16">
          {%- for product in collection.products -%}
            {%- assign product_tags = '' -%}
            {%- for tag in product.tags -%}{%- assign product_tags = product_tags | append: tag | append: ',' -%}{%- endfor -%}
            {%- for option in product.options_with_values -%}
              {%- unless option.name == 'Title' -%}
                {%- assign option_handle = option.name | handle -%}
                {%- for value in option.values -%}
                  {%- assign value_handle = value | handle -%}
                  {%- assign product_tags = product_tags | append: option_handle | append: ':' | append: value_handle | append: ',' -%}
                {%- endfor -%}
              {%- endunless -%}
            {%- endfor -%}
            <div class="product-filter-item" data-tags="{{ product_tags | downcase | escape }}" data-price="{{ product.price }}"
                 data-title="{{ product.title | escape }}" data-created="{{ product.created_at | date: '%s' }}">
              {% render 'product-card', product: product, show_quick_add: true %}
            </div>
          {%- else -%}
            <p class="col-span-full font-body-lg text-on-surface-variant">{{ 'collections.empty' | t }}</p>
          {%- endfor -%}
        </div>
      </div>
      <p data-no-results hidden class="text-center font-body-lg text-on-surface-variant py-16">{{ 'collections.empty' | t }}</p>
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="mt-24 flex justify-center items-center gap-8" aria-label="pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="material-symbols-outlined text-primary hover:text-terracotta transition-colors">arrow_back</a>
        {%- endif -%}
        <div class="flex items-center gap-6 font-label-caps text-label-caps">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a class="text-on-surface-variant hover:text-primary transition-colors" href="{{ part.url }}">{{ part.title | prepend: '0' | slice: -2, 2 }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="text-primary font-bold border-b border-primary pb-1">{{ part.title | prepend: '0' | slice: -2, 2 }}</span>
            {%- else -%}
              <span class="text-on-surface-variant">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="material-symbols-outlined text-primary hover:text-terracotta transition-colors">arrow_forward</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 12, "max": 96, "step": 12, "default": 48, "info": "Filtering/sorting only apply to products on the current page — set this high enough to cover the collection so filters feel instant." }
  ]
}
{% endschema %}
