<section class="overflow-hidden py-3.5" style="background: #494D57;" aria-label="Benefits ticker">
  <div class="flex animate-marquee whitespace-nowrap">
    {%- assign items = "FREE SHIPPING OVER 2,500 EGP|HANDCRAFTED WITH LOVE|NEW ARRIVALS WEEKLY|ETHICALLY SOURCED FABRICS|COMPLIMENTARY GIFT WRAPPING|FREE RETURNS WITHIN 30 DAYS" | split: "|" -%}
    {%- for i in (1..3) -%}
      {%- for item in items -%}
        <span class="inline-flex items-center">
          <span class="text-white/55 text-[9px] tracking-[0.35em] uppercase mx-8 font-medium">
            {{ item }}
          </span>
          <img src="{{ 'logo-monogram-flower.svg' | asset_url }}" alt="" class="w-2 h-2 object-contain brightness-0 invert opacity-25" loading="lazy">
        </span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust marquee",
  "settings": [],
  "presets": [{ "name": "Trust marquee" }]
}
{% endschema %}
