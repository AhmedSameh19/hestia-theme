  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter px-margin-mobile md:px-margin-desktop py-12 max-w-container-max mx-auto">
    <div class="md:col-span-5 mb-8 md:mb-0">
      {%- if section.settings.wordmark -%}
        <img width="{{ section.settings.wordmark.width }}" height="{{ section.settings.wordmark.height }}" src="{{ section.settings.wordmark | image_url: width: 480 }}" alt="{{ shop.name }}" class="h-12 w-auto object-contain mb-4">
      {%- else -%}
        {%- comment -%} HESTIA wordmark (branding/main-logo) {%- endcomment -%}
