            <path d="m490.22,495v17.3h-2.64c0-2.67-.34-4.46-1.01-5.38-.68-.91-1.83-1.37-3.45-1.37h-47.45c-1.49,0-2.6.46-3.35,1.37-.74.91-1.12,2.71-1.12,5.38h-2.64v-17.3h61.64Z"/>
