          </g>
        </svg>
      {%- endif -%}
      <p class="font-body-md text-charcoal/80 mb-4 max-w-sm">{{ section.settings.newsletter_text }}</p>
      {% form 'customer', class: 'max-w-md' %}
        {%- if form.posted_successfully? -%}
          <p class="font-body-md text-sage">{{ 'general.subscribe_success' | t }}</p>
        {%- else -%}
          {{ form.errors | default_errors }}
          <div class="flex gap-4">
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="email" name="contact[email]" required value="{{ form.email }}"
                   class="flex-1 bg-transparent border-b border-charcoal/30 py-3 text-charcoal placeholder:text-charcoal/50 focus:outline-none focus:border-charcoal transition-colors"
                   placeholder="{{ 'general.email_placeholder' | t }}">
            <button type="submit" class="font-label-caps text-label-caps text-charcoal hover:text-terracotta transition-colors tracking-widest uppercase">
              {{ 'general.subscribe' | t }}
            </button>
          </div>
        {%- endif -%}
      {% endform %}
    </div>

    {%- assign menus = 'menu_1,menu_2,menu_3' | split: ',' -%}
    {%- for id in menus -%}
      {%- assign menu = section.settings[id] -%}
      {%- if menu != blank -%}
        <div class="md:col-span-2 {% if forloop.first %}md:col-start-7{% endif %} flex flex-col gap-4">
          <h4 class="font-label-caps text-label-caps text-charcoal font-bold mb-4 uppercase">{{ menu.title }}</h4>
          {%- for link in menu.links -%}
            <a class="font-label-caps text-label-caps text-charcoal/80 hover:text-terracotta transition-colors uppercase" href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="px-margin-mobile md:px-margin-desktop py-6 border-t border-charcoal/10 max-w-container-max mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
    <p class="font-label-caps text-[10px] text-charcoal/60 tracking-widest uppercase">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ powered_by_link }}
    </p>
    <div class="flex items-center gap-6">
      {%- if section.settings.social_instagram != blank -%}
        <a href="{{ section.settings.social_instagram }}" aria-label="Instagram" class="text-charcoal/60 hover:text-terracotta transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.social_facebook != blank -%}
        <a href="{{ section.settings.social_facebook }}" aria-label="Facebook" class="text-charcoal/60 hover:text-terracotta transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.2h-3.1V7.7c0-.9.3-1.6 1.7-1.6h1.5V3.2c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.9H8v3.2h2.8v8h2.7z"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.social_tiktok != blank -%}
        <a href="{{ section.settings.social_tiktok }}" aria-label="TikTok" class="text-charcoal/60 hover:text-terracotta transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 3c.4 2.1 1.8 3.5 3.9 3.6v3c-1.5 0-2.8-.5-3.9-1.3v5.7c0 3.6-2.6 5.9-5.7 5.9-3 0-5.4-2.2-5.4-5.3 0-3 2.3-5.3 5.5-5.3.3 0 .7 0 1 .1v3.1c-.3-.1-.6-.2-1-.2-1.4 0-2.5 1-2.5 2.4 0 1.4 1.1 2.3 2.4 2.3 1.5 0 2.6-1 2.6-2.9V3h3.1z"/></svg>
        </a>
      {%- endif -%}
      <img width="752" height="1000" src="{{ 'logo-monogram.png' | asset_url }}" alt="" class="w-6 h-6 object-contain opacity-30">
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "wordmark", "label": "Wordmark", "info": "Defaults to the HESTIA caption-bar lockup" },
    { "type": "textarea", "id": "newsletter_text", "label": "Newsletter text", "default": "Join our inner circle for early access to collections and editorial musings on the art of living." },
    { "type": "link_list", "id": "menu_1", "label": "Menu 1", "default": "footer" },
    { "type": "link_list", "id": "menu_2", "label": "Menu 2" },
    { "type": "link_list", "id": "menu_3", "label": "Menu 3" },
    { "type": "url", "id": "social_instagram", "label": "Instagram URL" },
    { "type": "url", "id": "social_facebook", "label": "Facebook URL" },
    { "type": "url", "id": "social_tiktok", "label": "TikTok URL" }
  ]
}
{% endschema %}
