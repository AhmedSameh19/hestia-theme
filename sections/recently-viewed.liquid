{%- comment -%}
  Recently viewed — theme.js tracks product handles in localStorage and fills the grid
  by fetching each product page with ?section_id=card-product. Stays hidden with no history.
{%- endcomment -%}
<section data-recently-viewed hidden class="pb-section-padding max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop fade-in-section">
  <div class="flex justify-between items-end mb-12">
    <div>
      <h2 class="font-headline-md text-headline-md mb-2">{{ section.settings.heading }}</h2>
      <p class="font-label-caps text-label-caps text-on-surface-variant uppercase">{{ section.settings.subheading }}</p>
    </div>
  </div>
  <div data-recently-viewed-grid class="grid grid-cols-2 md:grid-cols-4 gap-gutter"></div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pick up where you left off" }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
