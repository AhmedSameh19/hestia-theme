{%- comment -%}
  Aurca Modals & Drawers — Complete replica of https://strong-chef-63840685.figma.site/
  Includes:
    - Cart / Bag Drawer
    - Wishlist Drawer
    - Quick View / Product Detail Modal
    - Search Modal
    - Size Guide Modal
    - Ask a Question Modal
    - Support & Help Modal
    - Account Modal
    - Coming Soon Modal
    - Cookie Consent Banner
    - Toast Notifications Container
{%- endcomment -%}

{%- comment -%} ==================== 1. CART / BAG DRAWER ==================== {%- endcomment -%}
<div id="modal-cart-drawer" hidden class="fixed inset-0 z-[100] transition-opacity duration-300" style="display: none;">
  <div class="modal-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm" data-close-drawer="cart"></div>
  <aside class="modal-panel absolute right-0 top-0 h-full w-full max-w-md bg-white dark:bg-[#1C1C1C] text-[#2D2E2D] dark:text-[#F0EDE8] shadow-2xl flex flex-col transition-transform duration-300 transform translate-x-0">
    {%- comment -%} Header {%- endcomment -%}
    <div class="flex items-center justify-between px-6 py-5 border-b border-black/10 dark:border-white/10 shrink-0">
      <h2 class="font-display text-xl font-light tracking-wide flex items-center gap-2">
        <span data-i18n="yourBag">Your Bag</span>
        <span class="text-sm text-[#494D57] dark:text-[#9A9690]">(<span data-drawer-cart-count>0</span>)</span>
      </h2>
      <button type="button" data-close-drawer="cart" class="p-1.5 hover:opacity-60 transition-opacity" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    {%- comment -%} Free Shipping Progress Bar {%- endcomment -%}
    <div class="px-6 py-3 bg-[#F8F6F1] dark:bg-[#242424] border-b border-black/5 dark:border-white/5 shrink-0">
      <p data-shipping-progress-text class="text-[10px] tracking-[0.15em] uppercase mb-1.5 text-[#494D57] dark:text-[#9A9690]">
        Free shipping over 2,500 EGP
      </p>
      <div class="w-full h-1 bg-black/10 dark:bg-white/10 overflow-hidden">
        <div data-shipping-progress-bar class="h-full bg-[#A87052] transition-all duration-300" style="width: 0%;"></div>
      </div>
    </div>

    {%- comment -%} Items Container {%- endcomment -%}
    <div data-drawer-cart-items class="flex-1 overflow-y-auto px-6 divide-y divide-black/5 dark:divide-white/5">
      {%- comment -%} Populated dynamically by theme.js {%- endcomment -%}
    </div>

    {%- comment -%} Empty State {%- endcomment -%}
    <div data-drawer-cart-empty hidden class="flex-1 flex flex-col items-center justify-center p-6 text-center">
      <div class="w-12 h-12 rounded-full flex items-center justify-center bg-[#A87052]/10 text-[#A87052] mb-4">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0"/>
        </svg>
      </div>
      <p class="font-display text-lg font-light mb-2" data-i18n="bagEmpty">Your bag is empty</p>
      <p class="text-xs text-[#494D57] dark:text-[#9A9690] mb-6 max-w-xs" data-i18n="bagEmptySub">Explore our curated collections of luxury silk and cotton homewear.</p>
      <button type="button" data-close-drawer="cart" class="px-8 py-3 text-[10px] tracking-[0.2em] uppercase font-medium bg-[#A87052] text-white hover:opacity-85 transition-opacity" data-i18n="continueShopping">
        Continue Shopping
      </button>
    </div>

    {%- comment -%} Footer Subtotal & Checkout {%- endcomment -%}
    <div data-drawer-cart-footer class="p-6 border-t border-black/10 dark:border-white/10 shrink-0 space-y-4 bg-white dark:bg-[#1C1C1C]">
      <div class="flex justify-between text-sm font-medium">
        <span class="text-[#494D57] dark:text-[#9A9690]" data-i18n="subtotal">Subtotal</span>
        <span data-drawer-cart-subtotal class="font-display text-lg font-light">0 EGP</span>
      </div>
      <p class="text-[11px] text-[#494D57]/70 dark:text-[#9A9690]/70" data-i18n="taxesNote">Taxes & shipping calculated at checkout.</p>
      <button type="button" data-drawer-checkout-btn
              class="w-full bg-[#A87052] text-white py-4 text-[10px] tracking-[0.22em] uppercase font-medium hover:opacity-85 transition-opacity shadow-lg shadow-[#A87052]/20"
              data-i18n="proceedCheckout">
        Proceed to Checkout
      </button>
      <button type="button" data-close-drawer="cart" class="w-full text-center text-[10px] tracking-[0.18em] uppercase text-[#494D57] dark:text-[#9A9690] hover:text-[#A87052] transition-colors" data-i18n="continueShopping">
        Continue Shopping
      </button>
    </div>
  </aside>
</div>

{%- comment -%} ==================== 2. WISHLIST DRAWER ==================== {%- endcomment -%}
<div id="modal-wishlist-drawer" hidden class="fixed inset-0 z-[100] transition-opacity duration-300" style="display: none;">
  <div class="modal-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm" data-close-drawer="wishlist"></div>
  <aside class="modal-panel absolute right-0 top-0 h-full w-full max-w-md bg-white dark:bg-[#1C1C1C] text-[#2D2E2D] dark:text-[#F0EDE8] shadow-2xl flex flex-col transition-transform duration-300">
    <div class="flex items-center justify-between px-6 py-5 border-b border-black/10 dark:border-white/10 shrink-0">
      <h2 class="font-display text-xl font-light tracking-wide flex items-center gap-2">
        <span data-i18n="yourWishlist">Your Wishlist</span>
        <span class="text-sm text-[#494D57] dark:text-[#9A9690]">(<span data-drawer-wishlist-count>0</span>)</span>
      </h2>
      <button type="button" data-close-drawer="wishlist" class="p-1.5 hover:opacity-60 transition-opacity" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <div data-drawer-wishlist-items class="flex-1 overflow-y-auto px-6 divide-y divide-black/5 dark:divide-white/5">
      {%- comment -%} Populated dynamically by theme.js {%- endcomment -%}
    </div>

    <div data-drawer-wishlist-empty hidden class="flex-1 flex flex-col items-center justify-center p-6 text-center">
      <div class="w-12 h-12 rounded-full flex items-center justify-center bg-[#A87052]/10 text-[#A87052] mb-4">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
      <p class="font-display text-lg font-light mb-2" data-i18n="wishlistEmpty">Your wishlist is empty</p>
      <p class="text-xs text-[#494D57] dark:text-[#9A9690] mb-6 max-w-xs" data-i18n="wishlistEmptySub">Save your favorite pieces by clicking the heart icon while browsing.</p>
      <button type="button" data-close-drawer="wishlist" class="px-8 py-3 text-[10px] tracking-[0.2em] uppercase font-medium bg-[#A87052] text-white hover:opacity-85 transition-opacity" data-i18n="exploreCollections">
        Explore Collections
      </button>
    </div>
  </aside>
</div>

{%- comment -%} ==================== 3. QUICK VIEW / PRODUCT DETAIL MODAL ==================== {%- endcomment -%}
<div id="modal-quickview" hidden class="fixed inset-0 z-[110] flex items-center justify-center p-4 md:p-6 transition-opacity duration-300" style="display: none;">
  <div class="modal-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm" data-close-modal="quickview"></div>
  <div class="relative bg-white dark:bg-[#1E1E1E] text-[#2D2E2D] dark:text-[#F0EDE8] w-full max-w-4xl max-h-[90vh] overflow-y-auto shadow-2xl z-10 p-6 md:p-8">
    <button type="button" data-close-modal="quickview" class="absolute top-5 right-5 p-2 hover:opacity-60 transition-opacity z-20" aria-label="Close modal">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      {%- comment -%} Left: Gallery {%- endcomment -%}
      <div>
        <div class="aspect-[3/4] overflow-hidden bg-[#E5D7CD] mb-3">
          <img id="qv-main-img" src="" alt="" class="w-full h-full object-cover object-top transition-transform duration-500">
        </div>
        <div id="qv-thumbnails" class="grid grid-cols-4 gap-2">
          {%- comment -%} Thumbnails populated dynamically {%- endcomment -%}
        </div>
      </div>

      {%- comment -%} Right: Details & Options {%- endcomment -%}
      <div class="flex flex-col">
        <p id="qv-eyebrow" class="text-[9px] tracking-[0.3em] uppercase mb-1 font-medium" style="color: #A87052;"></p>
        <h3 id="qv-title" class="font-display text-2xl md:text-3xl font-light mb-2"></h3>
        
        <div class="flex items-center gap-3 mb-4">
          <div class="flex gap-0.5 text-[#A87052]">
            {%- for i in (1..5) -%}
              <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {%- endfor -%}
          </div>
          <span class="text-xs text-[#494D57] dark:text-[#9A9690]">5.0 (48 reviews)</span>
        </div>

        <div class="flex items-center gap-3 mb-5">
          <span id="qv-price" class="text-xl font-medium"></span>
          <span id="qv-compare" class="text-sm line-through text-[#BCBCBC] hidden"></span>
        </div>

        <p id="qv-tagline" class="italic text-sm mb-3 text-[#494D57] dark:text-[#9A9690] font-display text-[16px]"></p>
        <p id="qv-body" class="text-xs leading-relaxed text-[#494D57] dark:text-[#9A9690] mb-5"></p>

        {%- comment -%} Care instructions bullets {%- endcomment -%}
        <div id="qv-care-wrap" class="mb-5 pb-5 border-b border-black/10 dark:border-white/10">
          <p class="text-[9px] tracking-[0.25em] uppercase font-semibold text-[#2D2E2D] dark:text-[#F0EDE8] mb-2">Fabric Care</p>
          <ul id="qv-care-list" class="grid grid-cols-2 gap-1.5 text-xs text-[#494D57] dark:text-[#9A9690]"></ul>
        </div>

        {%- comment -%} Color selector {%- endcomment -%}
        <div class="mb-5">
          <label class="block text-[9px] tracking-[0.25em] uppercase font-semibold text-[#2D2E2D] dark:text-[#F0EDE8] mb-2">Color</label>
          <div id="qv-colors" class="flex gap-2"></div>
        </div>

        {%- comment -%} Size selector {%- endcomment -%}
        <div class="mb-6">
          <div class="flex items-center justify-between mb-2">
            <label class="text-[9px] tracking-[0.25em] uppercase font-semibold text-[#2D2E2D] dark:text-[#F0EDE8]">Size</label>
            <button type="button" data-size-guide-open class="text-[9px] tracking-[0.15em] uppercase underline text-[#A87052]">Size Guide</button>
          </div>
          <div id="qv-sizes" class="flex gap-2">
            {%- assign sizes = "XS,S,M,L,XL" | split: "," -%}
            {%- for s in sizes -%}
              <button type="button" data-qv-size="{{ s }}"
                      class="qv-size-btn w-10 h-10 border text-xs font-medium transition-colors {% if s == 'M' %}border-[#A87052] bg-[#A87052] text-white{% else %}border-black/15 dark:border-white/15 hover:border-[#A87052]{% endif %}">
                {{ s }}
              </button>
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} Qty & Add to Bag {%- endcomment -%}
        <div class="flex items-center gap-3 mb-6">
          <div class="flex items-center border border-black/15 dark:border-white/15 h-12 px-3 gap-4">
            <button type="button" id="qv-qty-minus" class="text-sm font-medium hover:text-[#A87052]">&minus;</button>
            <span id="qv-qty" class="text-xs font-medium min-w-[16px] text-center">1</span>
            <button type="button" id="qv-qty-plus" class="text-sm font-medium hover:text-[#A87052]">&plus;</button>
          </div>
          <button type="button" id="qv-add-btn"
                  class="flex-1 bg-[#A87052] text-white h-12 px-6 text-[10px] tracking-[0.22em] uppercase font-medium hover:opacity-85 transition-opacity"
                  data-i18n="addToBag">
            Add to Bag
          </button>
          <button type="button" id="qv-wish-btn" class="w-12 h-12 border border-black/15 dark:border-white/15 flex items-center justify-center hover:border-[#A87052] text-[#494D57] hover:text-[#A87052] transition-colors" aria-label="Wishlist">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </button>
        </div>

        {%- comment -%} Reassurance tags {%- endcomment -%}
        <div class="pt-4 border-t border-black/10 dark:border-white/10 space-y-1.5 text-[11px] text-[#494D57] dark:text-[#9A9690]">
          <p class="flex items-center gap-2">&check; Hand-finished seams & mother-of-pearl buttons</p>
          <p class="flex items-center gap-2">&check; Complimentary gift packaging included</p>
          <p class="flex items-center gap-2">&check; Free shipping on orders over 2,500 EGP</p>
        </div>
      </div>
    </div>
  </div>
</div>

{%- comment -%} ==================== 4. SEARCH MODAL ==================== {%- endcomment -%}
<div id="modal-search" hidden class="fixed inset-0 z-[110] flex items-start justify-center p-4 md:pt-16 transition-opacity duration-300" style="display: none;">
  <div class="modal-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm" data-close-modal="search"></div>
  <div class="relative bg-white dark:bg-[#1E1E1E] text-[#2D2E2D] dark:text-[#F0EDE8] w-full max-w-2xl max-h-[85vh] overflow-y-auto shadow-2xl z-10 p-6 md:p-8">
    <div class="flex items-center gap-4 border-b border-black/10 dark:border-white/10 pb-4 mb-6">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[#494D57] dark:text-[#9A9690]"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input type="search" id="search-modal-input" placeholder="Search pyjamas, fabrics, collections..."
             autocomplete="off"
             class="flex-1 bg-transparent text-base outline-none placeholder:text-[#494D57]/40 dark:placeholder:text-[#9A9690]/40 font-light">
      <button type="button" data-close-modal="search" class="p-1 hover:opacity-60 transition-opacity" aria-label="Close search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    {%- comment -%} Filter chips {%- endcomment -%}
    <div class="flex flex-wrap gap-2 mb-6">
      {%- assign chips = "All,Women,Men,Together,Silk,Cotton,Modal" | split: "," -%}
      {%- for chip in chips -%}
        <button type="button" data-search-chip="{{ chip }}" class="text-[9px] tracking-[0.18em] uppercase px-3 py-1.5 border border-black/10 dark:border-white/10 hover:border-[#A87052] transition-colors font-medium">
          {{ chip }}
        </button>
      {%- endfor -%}
    </div>

    {%- comment -%} Results container {%- endcomment -%}
    <div id="search-modal-results" class="divide-y divide-black/5 dark:divide-white/5 max-h-[50vh] overflow-y-auto">
      {%- comment -%} Populated dynamically {%- endcomment -%}
    </div>
  </div>
</div>

{%- comment -%} ==================== 5. SIZE GUIDE MODAL ==================== {%- endcomment -%}
<div id="modal-sizeguide" hidden class="fixed inset-0 z-[120] flex items-center justify-center p-4 md:p-6 transition-opacity duration-300" style="display: none;">
  <div class="modal-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm" data-close-modal="sizeguide"></div>
  <div class="relative bg-white dark:bg-[#1E1E1E] text-[#2D2E2D] dark:text-[#F0EDE8] w-full max-w-2xl max-h-[90vh] overflow-y-auto shadow-2xl z-10 p-6 md:p-8">
    <button type="button" data-close-modal="sizeguide" class="absolute top-5 right-5 p-2 hover:opacity-60 transition-opacity" aria-label="Close size guide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <p class="text-[9px] tracking-[0.4em] uppercase mb-1" style="color: #A87052;">Fit & Dimensions</p>
    <h3 class="font-display text-2xl font-light mb-6">Size Guide</h3>

    {%- comment -%} Tabs {%- endcomment -%}
    <div class="flex border-b border-black/10 dark:border-white/10 mb-6 gap-6">
      <button type="button" data-sg-tab="Women" class="pb-2 text-[10px] tracking-[0.2em] uppercase font-medium border-b-2 border-[#A87052] text-[#A87052]">Women</button>
      <button type="button" data-sg-tab="Men" class="pb-2 text-[10px] tracking-[0.2em] uppercase font-medium border-b-2 border-transparent text-[#494D57] dark:text-[#9A9690] hover:text-[#A87052]">Men</button>
      <button type="button" data-sg-tab="Together" class="pb-2 text-[10px] tracking-[0.2em] uppercase font-medium border-b-2 border-transparent text-[#494D57] dark:text-[#9A9690] hover:text-[#A87052]">Together</button>
    </div>

    {%- comment -%} Measurement Table {%- endcomment -%}
    <div class="overflow-x-auto mb-8">
      <table class="w-full text-xs text-left">
        <thead>
          <tr class="border-b border-black/10 dark:border-white/10 text-[9px] tracking-[0.2em] uppercase text-[#494D57] dark:text-[#9A9690]">
            <th class="py-2.5">Size</th>
            <th class="py-2.5">Bust / Chest (cm)</th>
            <th class="py-2.5">Waist (cm)</th>
            <th class="py-2.5">Hips (cm)</th>
            <th class="py-2.5">EU Size</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-black/5 dark:divide-white/5">
          <tr><td class="py-3 font-medium">XS</td><td>82 – 86</td><td>62 – 66</td><td>88 – 92</td><td>34</td></tr>
          <tr><td class="py-3 font-medium">S</td><td>86 – 90</td><td>66 – 70</td><td>92 – 96</td><td>36</td></tr>
          <tr><td class="py-3 font-medium">M</td><td>90 – 96</td><td>70 – 76</td><td>96 – 102</td><td>38 – 40</td></tr>
          <tr><td class="py-3 font-medium">L</td><td>96 – 102</td><td>76 – 82</td><td>102 – 108</td><td>42</td></tr>
          <tr><td class="py-3 font-medium">XL</td><td>102 – 108</td><td>82 – 88</td><td>108 – 114</td><td>44</td></tr>
        </tbody>
      </table>
    </div>

    <div class="p-4 bg-[#F8F6F1] dark:bg-[#242424] text-xs text-[#494D57] dark:text-[#9A9690] leading-relaxed">
      <p class="font-medium text-[#2D2E2D] dark:text-[#F0EDE8] mb-1">How to Measure:</p>
      <p>Bust/Chest: Measure across the fullest part of your chest, keeping tape horizontal. Waist: Measure around natural waistline. Hips: Stand with feet together and measure fullest part.</p>
    </div>
  </div>
</div>

{%- comment -%} ==================== 6. ASK A QUESTION MODAL ==================== {%- endcomment -%}
<div id="modal-askquestion" hidden class="fixed inset-0 z-[120] flex items-center justify-center p-4 transition-opacity duration-300" style="display: none;">
  <div class="modal-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm" data-close-modal="askquestion"></div>
  <div class="relative bg-white dark:bg-[#1E1E1E] text-[#2D2E2D] dark:text-[#F0EDE8] w-full max-w-lg shadow-2xl z-10 p-6 md:p-8">
    <button type="button" data-close-modal="askquestion" class="absolute top-5 right-5 p-2 hover:opacity-60 transition-opacity" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <p class="text-[9px] tracking-[0.4em] uppercase mb-1" style="color: #A87052;">Concierge Support</p>
    <h3 class="font-display text-2xl font-light mb-1">Ask a Question</h3>
    <p id="ask-product-name" class="text-xs text-[#494D57] dark:text-[#9A9690] mb-6 font-medium"></p>

    <form id="ask-question-form" class="space-y-4">
      <div>
        <label class="block text-[9px] tracking-[0.2em] uppercase font-medium mb-1">Your Name</label>
        <input type="text" required class="w-full border border-black/15 dark:border-white/15 bg-transparent px-4 py-2.5 text-xs outline-none focus:border-[#A87052]">
      </div>
      <div>
        <label class="block text-[9px] tracking-[0.2em] uppercase font-medium mb-1">Email Address</label>
        <input type="email" required class="w-full border border-black/15 dark:border-white/15 bg-transparent px-4 py-2.5 text-xs outline-none focus:border-[#A87052]">
      </div>
      <div>
        <label class="block text-[9px] tracking-[0.2em] uppercase font-medium mb-1">Question / Inquiry</label>
        <textarea rows="3" required class="w-full border border-black/15 dark:border-white/15 bg-transparent px-4 py-2.5 text-xs outline-none focus:border-[#A87052] resize-none"></textarea>
      </div>
      <button type="submit" class="w-full py-3.5 bg-[#A87052] text-white text-[10px] tracking-[0.22em] uppercase font-medium hover:opacity-85 transition-opacity">
        Send Inquiry
      </button>
    </form>
    <div id="ask-question-success" hidden class="text-center py-8 space-y-2">
      <p class="font-display text-xl font-light text-[#A87052]">&check; Message Sent</p>
      <p class="text-xs text-[#494D57] dark:text-[#9A9690]">Our concierge team will reply to your email within 24 hours.</p>
    </div>
  </div>
</div>

{%- comment -%} ==================== 7. SUPPORT & HELP MODAL ==================== {%- endcomment -%}
<div id="modal-support" hidden class="fixed inset-0 z-[120] flex items-center justify-center p-4 transition-opacity duration-300" style="display: none;">
  <div class="modal-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm" data-close-modal="support"></div>
  <div class="relative bg-white dark:bg-[#1E1E1E] text-[#2D2E2D] dark:text-[#F0EDE8] w-full max-w-xl max-h-[85vh] overflow-y-auto shadow-2xl z-10 p-6 md:p-8">
    <button type="button" data-close-modal="support" class="absolute top-5 right-5 p-2 hover:opacity-60 transition-opacity" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <p class="text-[9px] tracking-[0.4em] uppercase mb-1" style="color: #A87052;">Aurca Client Service</p>
    <h3 class="font-display text-2xl font-light mb-6">Support & Help</h3>

    <div class="space-y-4 mb-8">
      <details class="group p-3 border border-black/10 dark:border-white/10 cursor-pointer">
        <summary class="font-medium text-xs flex justify-between items-center list-none">
          What fabrics does Aurca craft with?
          <span class="text-sm transition-transform group-open:rotate-180">&darr;</span>
        </summary>
        <p class="mt-2 text-xs text-[#494D57] dark:text-[#9A9690] leading-relaxed">
          We use 100% long-staple mulberry silk (grade 6A, 22 momme), GOTS-certified organic cotton, and certified Austrian modal woven for enduring softness and shape.
        </p>
      </details>

      <details class="group p-3 border border-black/10 dark:border-white/10 cursor-pointer">
        <summary class="font-medium text-xs flex justify-between items-center list-none">
          How do I care for my silk pyjamas?
          <span class="text-sm transition-transform group-open:rotate-180">&darr;</span>
        </summary>
        <p class="mt-2 text-xs text-[#494D57] dark:text-[#9A9690] leading-relaxed">
          Hand wash in cold water using a pH-neutral silk detergent. Lay flat to dry away from direct sunlight. Cool iron inside out while slightly damp.
        </p>
      </details>

      <details class="group p-3 border border-black/10 dark:border-white/10 cursor-pointer">
        <summary class="font-medium text-xs flex justify-between items-center list-none">
          What are your delivery and return timelines?
          <span class="text-sm transition-transform group-open:rotate-180">&darr;</span>
        </summary>
        <p class="mt-2 text-xs text-[#494D57] dark:text-[#9A9690] leading-relaxed">
          Orders arrive within 2–4 business days. We offer complimentary 30-day returns on all unworn items in original luxury packaging with tags attached.
        </p>
      </details>
    </div>

    <div class="p-4 bg-[#F8F6F1] dark:bg-[#242424] flex items-center justify-between text-xs">
      <div>
        <p class="font-medium">Direct Concierge:</p>
        <p class="text-[#494D57] dark:text-[#9A9690]">concierge@aurca.com</p>
      </div>
      <a href="mailto:concierge@aurca.com" class="px-4 py-2 bg-[#A87052] text-white text-[9px] tracking-[0.2em] uppercase font-medium">
        Email Us
      </a>
    </div>
  </div>
</div>

{%- comment -%} ==================== 8. ACCOUNT MODAL ==================== {%- endcomment -%}
<div id="modal-account" hidden class="fixed inset-0 z-[120] flex items-center justify-center p-4 transition-opacity duration-300" style="display: none;">
  <div class="modal-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm" data-close-modal="account"></div>
  <div class="relative bg-white dark:bg-[#1E1E1E] text-[#2D2E2D] dark:text-[#F0EDE8] w-full max-w-md shadow-2xl z-10 p-6 md:p-8">
    <button type="button" data-close-modal="account" class="absolute top-5 right-5 p-2 hover:opacity-60 transition-opacity" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <p class="text-[9px] tracking-[0.4em] uppercase mb-1" style="color: #A87052;">Client Portal</p>
    <h3 class="font-display text-2xl font-light mb-6" id="account-modal-title">Sign In</h3>

    <div class="flex border-b border-black/10 dark:border-white/10 mb-6 gap-6">
      <button type="button" id="tab-login" class="pb-2 text-[10px] tracking-[0.2em] uppercase font-medium border-b-2 border-[#A87052] text-[#A87052]">Sign In</button>
      <button type="button" id="tab-register" class="pb-2 text-[10px] tracking-[0.2em] uppercase font-medium border-b-2 border-transparent text-[#494D57] dark:text-[#9A9690]">Create Account</button>
    </div>

    <form id="account-modal-form" class="space-y-4">
      <div id="register-name-field" hidden>
        <label class="block text-[9px] tracking-[0.2em] uppercase font-medium mb-1">Full Name</label>
        <input type="text" class="w-full border border-black/15 dark:border-white/15 bg-transparent px-4 py-2.5 text-xs outline-none focus:border-[#A87052]">
      </div>
      <div>
        <label class="block text-[9px] tracking-[0.2em] uppercase font-medium mb-1">Email</label>
        <input type="email" required class="w-full border border-black/15 dark:border-white/15 bg-transparent px-4 py-2.5 text-xs outline-none focus:border-[#A87052]">
      </div>
      <div>
        <label class="block text-[9px] tracking-[0.2em] uppercase font-medium mb-1">Password</label>
        <input type="password" required class="w-full border border-black/15 dark:border-white/15 bg-transparent px-4 py-2.5 text-xs outline-none focus:border-[#A87052]">
      </div>
      <button type="submit" id="account-submit-btn" class="w-full py-3.5 bg-[#A87052] text-white text-[10px] tracking-[0.22em] uppercase font-medium hover:opacity-85 transition-opacity">
        Sign In
      </button>
    </form>
  </div>
</div>

{%- comment -%} ==================== 9. COMING SOON MODAL ==================== {%- endcomment -%}
<div id="modal-comingsoon" hidden class="fixed inset-0 z-[120] flex items-center justify-center p-4 transition-opacity duration-300" style="display: none;">
