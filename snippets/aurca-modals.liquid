  <div class="relative bg-white dark:bg-[#1E1E1E] text-[#2D2E2D] dark:text-[#F0EDE8] w-full max-w-sm shadow-2xl z-10 p-6 md:p-8 text-center">
    <button type="button" data-close-modal="comingsoon" class="absolute top-4 right-4 p-2 hover:opacity-60 transition-opacity" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <div class="flex justify-center mb-4">
      <img src="{{ 'logo-monogram-flower.svg' | asset_url }}" alt="" class="w-10 h-10 object-contain">
    </div>
    <h3 id="comingsoon-title" class="font-display text-2xl font-light mb-2">Coming Soon</h3>
    <p class="text-xs text-[#494D57] dark:text-[#9A9690] leading-relaxed mb-6">
      We are preparing this experience for the upcoming season. Join our Circle to be the first to receive updates.
    </p>
    <button type="button" data-close-modal="comingsoon" class="w-full py-3 bg-[#A87052] text-white text-[10px] tracking-[0.2em] uppercase font-medium hover:opacity-85 transition-opacity">
      Understood
    </button>
  </div>
</div>

{%- comment -%} ==================== 10. CHECKOUT CONFIRMATION MODAL ==================== {%- endcomment -%}
<div id="modal-checkout" hidden class="fixed inset-0 z-[130] flex items-center justify-center p-4 transition-opacity duration-300" style="display: none;">
  <div class="modal-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm" data-close-modal="checkout"></div>
  <div class="relative bg-white dark:bg-[#1E1E1E] text-[#2D2E2D] dark:text-[#F0EDE8] w-full max-w-lg shadow-2xl z-10 p-6 md:p-8">
    <button type="button" data-close-modal="checkout" class="absolute top-5 right-5 p-2 hover:opacity-60 transition-opacity" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <p class="text-[9px] tracking-[0.4em] uppercase mb-1" style="color: #A87052;">Secure Order</p>
    <h3 class="font-display text-2xl font-light mb-4" id="checkout-modal-title">Confirm Order</h3>

    <div id="checkout-order-summary" class="mb-6 p-4 bg-[#F8F6F1] dark:bg-[#242424] text-xs space-y-2">
      <div class="flex justify-between font-medium">
        <span>Items:</span>
        <span id="checkout-total-items">0 items</span>
      </div>
      <div class="flex justify-between font-medium">
        <span>Total:</span>
        <span id="checkout-total-price" class="text-sm font-semibold text-[#A87052]">0 EGP</span>
      </div>
      <p class="text-[11px] text-[#494D57] dark:text-[#9A9690] pt-2 border-t border-black/10 dark:border-white/10">
        Please confirm you are ready to place this order. Your card will be processed securely.
      </p>
    </div>

    <div class="flex gap-3">
      <button type="button" data-close-modal="checkout" class="flex-1 py-3.5 border border-black/20 dark:border-white/20 text-[10px] tracking-[0.2em] uppercase font-medium hover:opacity-70 transition-opacity">
        Cancel
      </button>
      <button type="button" id="checkout-confirm-btn" class="flex-1 py-3.5 bg-[#A87052] text-white text-[10px] tracking-[0.2em] uppercase font-medium hover:opacity-85 transition-opacity">
        Confirm &amp; Pay
      </button>
    </div>
  </div>
</div>

{%- comment -%} ==================== 11. COOKIE CONSENT BANNER ==================== {%- endcomment -%}
<div id="cookie-consent-banner" hidden class="fixed bottom-4 left-4 right-4 md:left-8 md:right-auto md:max-w-md z-[90] bg-[#2D2E2D] text-white p-5 shadow-2xl border border-white/10 transition-transform duration-300" style="display: none;">
  <p class="text-xs leading-relaxed mb-4 text-white/80">
    We use cookies and similar technologies to enhance your luxury shopping experience, personalize content, and analyze our traffic.
  </p>
  <div class="flex items-center gap-3">
    <button type="button" id="cookie-accept-btn" class="px-5 py-2 text-[9px] tracking-[0.2em] uppercase font-medium bg-[#A87052] text-white hover:opacity-85 transition-opacity">
      Accept All
    </button>
    <button type="button" id="cookie-decline-btn" class="px-4 py-2 text-[9px] tracking-[0.2em] uppercase text-white/50 hover:text-white transition-colors">
      Decline
    </button>
  </div>
</div>

