{%- comment -%}
  Aurca Product Card — matches https://strong-chef-63840685.figma.site/
  Accepts:
    - product: Shopify product object OR demo object
    - is_demo: boolean
{%- endcomment -%}

{%- if product -%}
  {%- assign p_id = product.id -%}
  {%- assign p_title = product.title -%}
  {%- assign p_url = product.url -%}
  {%- assign p_price = product.price | money -%}
  {%- assign p_compare = product.compare_at_price | money -%}
  {%- assign p_has_compare = false -%}
  {%- if product.compare_at_price > product.price -%}
    {%- assign p_has_compare = true -%}
    {%- assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
  {%- endif -%}
  {%- assign p_cat = product.type | default: 'Women' -%}
  {%- if product.tags contains 'women' or product.tags contains 'Women' -%}
    {%- assign p_cat = 'Women' -%}
  {%- elsif product.tags contains 'men' or product.tags contains 'Men' -%}
    {%- assign p_cat = 'Men' -%}
  {%- elsif product.tags contains 'together' or product.tags contains 'Together' -%}
    {%- assign p_cat = 'Together' -%}
  {%- endif -%}
  {%- assign p_fabric = product.metafields.custom.fabric_care | default: 'Mulberry Silk' -%}
  {%- if p_fabric contains '.' -%}
    {%- assign p_fabric = p_fabric | split: '.' | first | remove: 'DUMMY: ' -%}
  {%- endif -%}
  {%- assign p_img = product.featured_image | image_url: width: 800 -%}
  {%- unless product.featured_image -%}
    {%- assign p_img = 'https://images.unsplash.com/photo-1766056278944-ca0e4f49e61f?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=800' -%}
  {%- endunless -%}

  <div class="group cursor-pointer product-card" data-product-id="{{ p_id }}" data-product-cat="{{ p_cat }}">
    {%- comment -%} Image Container with 3/4 Aspect Ratio {%- endcomment -%}
    <div class="relative overflow-hidden mb-4 product-image-wrap" style="background: #E5D7CD;" data-open-quickview="{{ p_id }}">
      <div class="overflow-hidden" style="aspect-ratio: 3/4;">
        <img src="{{ p_img }}" alt="{{ p_title | escape }}" loading="lazy"
             class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700">
      </div>

      {%- comment -%} Badges {%- endcomment -%}
      {%- if product.tags contains 'bestseller' or product.tags contains 'Bestseller' -%}
        <div class="absolute top-4 left-4 text-white text-[7px] tracking-[0.28em] uppercase px-2.5 py-1.5 font-medium" style="background: #A87052;">
          Bestseller
        </div>
      {%- elsif p_cat == 'Together' -%}
        <div class="absolute top-4 left-4 text-white text-[7px] tracking-[0.28em] uppercase px-2.5 py-1.5 font-medium" style="background: #4A1A28;">
          Together
        </div>
      {%- elsif p_has_compare -%}
        <div class="absolute top-4 left-4 text-white text-[7px] tracking-[0.28em] uppercase px-2.5 py-1.5 font-medium" style="background: #97606C;">
          -{{ discount }}%
        </div>
      {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
        <div class="absolute top-4 left-4 text-white text-[7px] tracking-[0.28em] uppercase px-2.5 py-1.5 font-medium" style="background: #494D57;">
          New
        </div>
      {%- endif -%}

      {%- comment -%} Wishlist Button {%- endcomment -%}
      <button type="button" data-wishlist-toggle="{{ p_id }}" class="wishlist-btn absolute top-4 right-4 w-8 h-8 bg-white/90 rounded-none flex items-center justify-center shadow-sm hover:bg-white transition-colors text-[#494D57] hover:text-[#A87052]" aria-label="Add to wishlist">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </button>

      {%- comment -%} Quick Size Add Overlay on Hover {%- endcomment -%}
      <div class="absolute bottom-0 left-0 right-0 p-3 transition-all duration-300 opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0"
           style="background: #2D2E2D;" onclick="event.stopPropagation();">
        <div class="flex items-center justify-between">
          <div class="flex gap-1 size-selector-group">
            {%- assign sizes = "XS,S,M,L,XL" | split: "," -%}
            {%- for s in sizes -%}
              <button type="button" data-size="{{ s }}"
                      class="size-pill w-7 h-7 text-[8px] font-medium transition-colors {% if s == 'M' %}active-size bg-[#A87052] text-white{% else %}bg-white/10 text-white hover:bg-white/20{% endif %}">
                {{ s }}
              </button>
            {%- endfor -%}
          </div>
          <button type="button" data-quick-add-btn="{{ p_id }}"
                  class="text-white text-[9px] tracking-[0.18em] uppercase px-4 py-1.5 transition-colors hover:opacity-80 font-medium"
                  style="background: #A87052;">
            Add
          </button>
        </div>
      </div>
    </div>

    {%- comment -%} Card Text Info {%- endcomment -%}
    <div>
      <p class="text-[8px] tracking-[0.28em] uppercase mb-1 font-medium" style="color: #A87052;">
        {{ p_cat }} &middot; {{ p_fabric }}
      </p>
      <h4 class="font-light mb-2 font-display text-[20px] text-[#2D2E2D] dark:text-[#F0EDE8] transition-colors">
        <a href="{{ p_url }}">{{ p_title }}</a>
      </h4>
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2">
          <span class="text-sm font-medium text-[#2D2E2D] dark:text-[#F0EDE8]">{{ p_price }}</span>
          {%- if p_has_compare -%}
            <span class="text-xs line-through text-[#BCBCBC]">{{ p_compare }}</span>
          {%- endif -%}
        </div>
        <div class="flex gap-1.5">
          <div class="w-3 h-3 rounded-full border border-black/15" style="background: #D4C8B4;"></div>
          <div class="w-3 h-3 rounded-full border border-black/15" style="background: #9E6E7A;"></div>
          <div class="w-3 h-3 rounded-full border border-black/15" style="background: #A87052;"></div>
        </div>
      </div>
      <button type="button" data-ask-question="{{ p_title | escape }}"
              class="text-[8px] tracking-[0.2em] uppercase hover:opacity-60 transition-opacity border-b pb-px text-[#494D57]/60 border-[#494D57]/40 dark:text-white/40">
        Ask a question
      </button>
    </div>
  </div>
{%- endif -%}
