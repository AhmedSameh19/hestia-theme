{%- comment -%}
  Solid brand-color block derived from the product's `color:` tag — used instead of
  photo placeholders (products ship without images; see store-data/SETUP.md).
  Accepts: item (product)
{%- endcomment -%}
{%- assign sw = '#DCC9B6' -%}
{%- for tag in item.tags -%}
  {%- if tag contains 'color:' -%}
    {%- assign cname = tag | remove: 'color:' | strip | downcase -%}
    {%- case cname -%}
      {%- when 'copper' -%}{%- assign sw = '#A87052' -%}
      {%- when 'charcoal' -%}{%- assign sw = '#2D2E2D' -%}
      {%- when 'slate' -%}{%- assign sw = '#494D57' -%}
      {%- when 'blush' -%}{%- assign sw = '#E5D7CD' -%}
      {%- when 'mauve' -%}{%- assign sw = '#97606C' -%}
      {%- when 'burgundy' -%}{%- assign sw = '#4A1A28' -%}
      {%- when 'silver' -%}{%- assign sw = '#BCBCBC' -%}
      {%- when 'cream' -%}{%- assign sw = '#F8F6F1' -%}
      {%- when 'terracotta' -%}{%- assign sw = '#A87052' -%}
      {%- when 'sand' -%}{%- assign sw = '#E5D7CD' -%}
      {%- when 'champagne' -%}{%- assign sw = '#F8F6F1' -%}
      {%- when 'sage' -%}{%- assign sw = '#A9B29B' -%}
      {%- when 'ivory' -%}{%- assign sw = '#FFFFF0' -%}
      {%- when 'taupe' -%}{%- assign sw = '#B5A08C' -%}
    {%- endcase -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
<div class="w-full h-full" style="background-color:{{ sw }}"></div>
